{
  "expo": {
    "name": "Naxr Merchant",
    "slug": "naxr-merchant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.softdev21.naxrmerchant",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "naxr",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d3c480c3-9026-4fe2-8ac6-a638def28e16"
      }
    },
    "owner": "softdev21s-team"
  }
}
